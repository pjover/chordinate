{
  "bindings": [
    {
      "id": "move-line-up-down",
      "action": "Move Line Up / Down",
      "cheatsheet": {"group": "Editing", "label": "Move / Swap Line Up / Down"},
      "vscode": {
        "entries": [
          {"command": "editor.action.moveLinesUpAction", "key": "ctrl+shift+up", "when": "editorTextFocus && !editorReadonly"},
          {"command": "editor.action.moveLinesDownAction", "key": "ctrl+shift+down", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-editor.action.moveLinesUpAction", "key": "alt+up", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-editor.action.moveLinesDownAction", "key": "alt+down", "when": "editorTextFocus && !editorReadonly"}
        ]
      },
      "zed": {
        "entries": [
          {"action": "editor::MoveLineUp", "key": "ctrl+shift+up", "context": "Editor"},
          {"action": "editor::MoveLineDown", "key": "ctrl+shift+down", "context": "Editor"},
          {"action": null, "key": "alt+up", "context": "Editor && mode == full"},
          {"action": null, "key": "alt+down", "context": "Editor && mode == full"}
        ]
      }
    },
    {
      "id": "swap-line-up-down-obsidian",
      "action": "Swap Line Up / Down (Obsidian)",
      "cheatsheet": false,
      "obsidian": {
        "entries": [
          {"command_id": "editor:swap-line-up", "key": "ctrl+shift+up"},
          {"command_id": "editor:swap-line-down", "key": "ctrl+shift+down"}
        ]
      },
      "note": "Same physical key as the VS Code Move Line Up/Down above."
    },
    {
      "id": "clone-caret-above-below",
      "action": "Clone Caret Above / Below",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "editor.action.insertCursorAbove", "key": "shift+alt+up", "when": "editorTextFocus"},
          {"command": "editor.action.insertCursorBelow", "key": "shift+alt+down", "when": "editorTextFocus"},
          {"command": "-editor.action.insertCursorAbove", "key": "ctrl+shift+up", "when": "editorTextFocus"},
          {"command": "-editor.action.insertCursorBelow", "key": "ctrl+shift+down", "when": "editorTextFocus"}
        ]
      },
      "zed": {
        "entries": [
          {"action": ["editor::AddSelectionAbove", {"skip_soft_wrap": true}], "key": "shift+alt+up", "context": "Editor"},
          {"action": ["editor::AddSelectionBelow", {"skip_soft_wrap": true}], "key": "shift+alt+down", "context": "Editor"}
        ]
      }
    },
    {
      "id": "delete-line",
      "action": "Delete Line",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "editor.action.deleteLines", "key": "ctrl+y", "when": "textInputFocus && !editorReadonly"},
          {"command": "-redo", "key": "ctrl+y", "when": "textInputFocus && !editorReadonly"}
        ]
      },
      "obsidian": {"entries": [{"command_id": "editor:delete-paragraph", "key": "ctrl+y"}]},
      "zed": {"entries": [{"action": "editor::DeleteLine", "key": "ctrl+y", "context": "Editor"}]},
      "note": "Strongest cross-app alignment in the project — matches Obsidian's own pre-existing binding. ctrl+y in VS Code and Zed deliberately displaces Redo (Redo stays on ctrl+shift+z)."
    },
    {
      "id": "duplicate-line",
      "action": "Duplicate Line or Selection",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "editor.action.duplicateSelection", "key": "ctrl+d", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-editor.action.addSelectionToNextFindMatch", "key": "ctrl+d"}
        ]
      },
      "zed": {"entries": [{"action": "editor::DuplicateSelection", "key": "ctrl+d", "context": "Editor"}]},
      "note": "VS Code has no default chord for Duplicate Selection (which duplicates the whole line when nothing is selected), so it takes ctrl+d here, displacing Add Selection to Next Find Match — that one stays available on ctrl+shift+l (Select All Occurrences, VS Code's native default). Obsidian has no duplicate-line command at all."
    },
    {
      "id": "join-lines",
      "action": "Join Lines",
      "cheatsheet": {"group": "Editing"},
      "vscode": {"entries": [{"command": "editor.action.joinLines", "key": "ctrl+shift+j"}]},
      "zed": {"entries": [{"action": "editor::JoinLines", "key": "ctrl+shift+j", "context": "Editor"}]},
      "note": "Plain ctrl+j was rejected — it collides with VS Code's own Toggle Panel chord."
    },
    {
      "id": "insert-line-above",
      "action": "Insert Line Above",
      "cheatsheet": {"group": "Editing"},
      "vscode": {"entries": [{"command": "editor.action.insertLineBefore", "key": "ctrl+shift+enter", "when": "editorTextFocus && !editorReadonly"}]},
      "zed": {"entries": [{"action": "editor::NewlineAbove", "key": "ctrl+shift+enter", "context": "Editor && mode == full"}]}
    },
    {
      "id": "toggle-word-wrap",
      "action": "Toggle Word Wrap",
      "cheatsheet": {"group": "Editing"},
      "vscode": {"entries": [{"command": "editor.action.toggleWordWrap", "key": "ctrl+alt+shift+z"}]},
      "zed": {"entries": [{"action": "editor::ToggleSoftWrap", "key": "ctrl+alt+shift+z", "context": "Editor"}]}
    },
    {
      "id": "comment-line",
      "action": "Comment Line",
      "cheatsheet": {"group": "Editing", "keys": ["ctrl+/", "ctrl+alt+shift+q"], "note": "also Ctrl+7 · Ctrl+Numpad÷"},
      "vscode": {
        "entries": [
          {"command": "editor.action.commentLine", "key": "ctrl+7", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-workbench.action.focusSeventhEditorGroup", "key": "ctrl+7"},
          {"command": "editor.action.commentLine", "key": "ctrl+numpad_divide", "when": "editorTextFocus && !editorReadonly"},
          {"command": "editor.action.commentLine", "key": "ctrl+alt+shift+q", "when": "editorTextFocus && !editorReadonly"}
        ]
      },
      "obsidian": {
        "entries": [
          {"command_id": "editor:toggle-comments", "key": "ctrl+/"},
          {"command_id": "editor:toggle-comments", "key": "ctrl+alt+shift+q"}
        ]
      },
      "zed": {
        "entries": [
          {"action": ["editor::ToggleComments", {"advance_downwards": false, "comment_empty_lines": false}], "key": "ctrl+/", "context": "Editor"},
          {"action": ["editor::ToggleComments", {"advance_downwards": false, "comment_empty_lines": false}], "key": "ctrl+7", "context": "Editor"},
          {"action": ["editor::ToggleComments", {"advance_downwards": false, "comment_empty_lines": false}], "key": "ctrl+alt+shift+q", "context": "Editor"}
        ]
      },
      "note": "Plain ctrl+/ needs no VS Code entry — already the native default. ctrl+7 and numpad-divide are accommodations for a Spanish keyboard layout. Obsidian lists ctrl+/ explicitly because binding the command replaces its default Mod+/ hotkey. Zed lists it so macOS gains Ctrl+/ next to Cmd+/; Zed has no numpad key names (the numpad / types '/', which ctrl+/ already matches), and its ctrl+7 displaces macOS's go-to-tab-7. The args match Zed's VS Code base keymap."
    },
    {
      "id": "search-in-file",
      "action": "Search in File",
      "cheatsheet": {"group": "Editing"},
      "vscode": {"entries": [{"command": "actions.find", "key": "ctrl+f", "when": "editorFocus || editorIsOpen"}]},
      "obsidian": {"entries": [{"command_id": "editor:open-search", "key": "ctrl+f"}]},
      "zed": {"entries": [{"action": "buffer_search::Deploy", "key": "ctrl+f", "context": "Editor && mode == full"}]},
      "note": "Already native on Linux in all three apps. On macOS VS Code and Zed gain Ctrl+F alongside Cmd+F (Zed loses its emacs-style cursor-right there), while Obsidian's custom hotkey replaces its Cmd+F default."
    },
    {
      "id": "replace-in-file",
      "action": "Replace in File",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "editor.action.startFindReplaceAction", "key": "ctrl+r", "when": "editorFocus || editorIsOpen"},
          {"command": "-workbench.action.openRecent", "key": "ctrl+r"}
        ]
      },
      "obsidian": {"entries": [{"command_id": "editor:open-search-replace", "key": "ctrl+r"}]},
      "zed": {
        "entries": [
          {"action": null, "key": "ctrl+r", "context": "Workspace"},
          {"action": "buffer_search::DeployReplace", "key": "ctrl+r", "context": "Editor && mode == full"}
        ]
      },
      "note": "ctrl+r displaces VS Code's Open Recent (still in the File menu and the command palette). Zed's Open Recent is unbound on ctrl+r too; the null also stops DeployReplace from falling through to it when the search bar is already open."
    },
    {
      "id": "search-in-all-files",
      "action": "Search in All Files",
      "cheatsheet": {"group": "Editing"},
      "vscode": {"entries": [{"command": "workbench.action.findInFiles", "key": "ctrl+shift+f"}]},
      "obsidian": {"entries": [{"command_id": "global-search:open", "key": "ctrl+shift+f"}]},
      "zed": {
        "entries": [
          {"action": "pane::DeploySearch", "key": "ctrl+shift+f", "context": "Workspace"},
          {"action": "pane::DeploySearch", "key": "ctrl+shift+f", "context": "Editor"}
        ]
      },
      "note": "Already native on Linux in all three apps. On macOS VS Code and Zed gain Ctrl+Shift+F alongside Cmd+Shift+F, while Obsidian's custom hotkey replaces its Cmd+Shift+F default. Zed needs an Editor-context entry too, because on macOS its editor binds ctrl+shift+f to select-right, which would outrank a Workspace-only binding."
    },
    {
      "id": "replace-in-all-files",
      "action": "Replace in All Files",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "workbench.action.replaceInFiles", "key": "ctrl+shift+r"},
          {"command": "-editor.action.refactor", "key": "ctrl+shift+r"}
        ]
      },
      "zed": {"entries": [{"action": ["pane::DeploySearch", {"replace_enabled": true}], "key": "ctrl+shift+r", "context": "Workspace"}]},
      "note": "ctrl+shift+r displaces VS Code's Refactor… menu (still reachable through Ctrl+. and the context menu) and Zed's Linux Rerun Task. Obsidian has no replace-across-vault command."
    },
    {
      "id": "surround-with-backticks",
      "action": "Surround with `` (inline code)",
      "cheatsheet": {"group": "Markdown", "label": "Surround with `code` (inline)"},
      "vscode": {"entries": [{"command": "markdown.extension.editing.toggleCodeSpan", "key": "ctrl+alt+shift+g"}]},
      "obsidian": {"entries": [{"command_id": "editor:toggle-code", "key": "ctrl+alt+shift+g"}]},
      "note": "Requires the Markdown All in One VS Code extension (yzhang.markdown-all-in-one) — no built-in alternative exists."
    },
    {
      "id": "surround-with-code-block",
      "action": "Surround with code block (fenced)",
      "cheatsheet": {"group": "Markdown"},
      "vscode": {"entries": [{"command": "markdown.extension.editing.toggleCodeBlock", "key": "ctrl+alt+shift+b"}]},
      "obsidian": {"entries": [{"command_id": "editor:insert-codeblock", "key": "ctrl+alt+shift+b"}]},
      "note": "Requires the same Markdown All in One VS Code extension as surround-with-backticks."
    },
    {
      "id": "toggle-pin",
      "action": "Toggle Pin Editor Tab",
      "cheatsheet": {"group": "App / window"},
      "vscode": {
        "entries": [
          {"command": "workbench.action.pinEditor", "key": "ctrl+alt+shift+t", "when": "!activeEditorIsPinned"},
          {"command": "workbench.action.unpinEditor", "key": "ctrl+alt+shift+t", "when": "activeEditorIsPinned"}
        ]
      },
      "obsidian": {"entries": [{"command_id": "workspace:toggle-pin", "key": "ctrl+alt+shift+t"}]},
      "zed": {"entries": [{"action": "pane::TogglePinTab", "key": "ctrl+alt+shift+t", "context": "Pane"}]},
      "note": "VS Code has no single 'toggle pin' command (a feature request for one is still open upstream) — two conditional bindings simulate it."
    },
    {
      "id": "reveal-active-file",
      "action": "Reveal Active File in Explorer",
      "cheatsheet": {"group": "App / window"},
      "vscode": {"entries": [{"command": "workbench.files.action.showActiveFileInExplorer", "key": "ctrl+alt+shift+e"}]},
      "obsidian": {"entries": [{"command_id": "file-explorer:reveal-active-file", "key": "ctrl+alt+shift+e"}]},
      "zed": {"entries": [{"action": "pane::RevealInProjectPanel", "key": "ctrl+alt+shift+e", "context": "Editor && mode == full"}]},
      "note": "In Zed this displaces the Linux Toggle Edit Prediction chord."
    },
    {
      "id": "show-in-file-manager",
      "action": "Show in File Explorer / Finder",
      "cheatsheet": {"group": "App / window"},
      "vscode": {"entries": [{"command": "revealFileInOS", "key": "ctrl+alt+shift+w"}]},
      "obsidian": {"entries": [{"command_id": "open-with-default-app:show", "key": "ctrl+alt+shift+w"}]},
      "zed": {"entries": [{"action": "editor::RevealInFileManager", "key": "ctrl+alt+shift+w", "context": "Editor"}]}
    },
    {
      "id": "open-with-default-app",
      "action": "Open in Default App (Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Open in Default App"},
      "obsidian": {"entries": [{"command_id": "open-with-default-app:open", "key": "ctrl+alt+shift+a"}]},
      "note": "VS Code has no built-in command for this."
    },
    {
      "id": "prev-next-tab-obsidian",
      "action": "Previous / Next Tab (Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Previous / Next Tab"},
      "obsidian": {
        "entries": [
          {"command_id": "workspace:previous-tab", "key": "ctrl+shift+tab"},
          {"command_id": "workspace:next-tab", "key": "ctrl+tab"}
        ]
      }
    },
    {
      "id": "daily-notes-obsidian",
      "action": "Open Daily Note (Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Open Daily Note"},
      "obsidian": {
        "entries": [
          {"command_id": "daily-notes", "key": "ctrl+n"},
          {"command_id": "file-explorer:new-file"}
        ]
      },
      "note": "Unbinds Obsidian's default New Note (Mod+N), which is Ctrl+N on Linux and would otherwise collide."
    },
    {
      "id": "zoom-in-out",
      "action": "Zoom In / Out (whole-app UI scale, not text size)",
      "cheatsheet": {"group": "App / window", "label": "Zoom In / Out (UI scale)", "keys": ["ctrl+plus", "ctrl+minus"]},
      "obsidian": {
        "entries": [
          {"command_id": "window:zoom-in", "key": "ctrl+plus"},
          {"command_id": "window:zoom-out", "key": "ctrl+minus"}
        ]
      },
      "zed": {
        "entries": [
          {"action": ["zed::IncreaseBufferFontSize", {"persist": false}], "key": "ctrl+plus"},
          {"action": ["zed::DecreaseBufferFontSize", {"persist": false}], "key": "ctrl+minus"}
        ]
      },
      "note": "VS Code needs no entries — ctrl+plus/ctrl+minus are already its native zoom in/out on every platform. Nautilus already uses the same keys by its own convention. Zed has no whole-app zoom: its View → Zoom In/Out menu scales the buffer font, so these entries use the same actions. They have no context, matching Zed's own zoom bindings, so on macOS they beat ctrl+minus's Go Back in panes. Reset is deliberately NOT unified — each app keeps its own working default (VS Code ctrl+numpad0, Obsidian ctrl+0, Zed Cmd+0 / Ctrl+0) since forcing one key costs more than a rarely-used action is worth."
    },
    {
      "id": "copy-cut-paste",
      "action": "Copy / Cut / Paste",
      "cheatsheet": {"group": "App / window"},
      "vscode": {
        "entries": [
          {"command": "editor.action.clipboardCopyAction", "key": "ctrl+c"},
          {"command": "editor.action.clipboardCutAction", "key": "ctrl+x"},
          {"command": "editor.action.clipboardPasteAction", "key": "ctrl+v"}
        ]
      },
      "obsidian": {
        "entries": [
          {"command_id": "editor:copy", "key": "ctrl+c"},
          {"command_id": "editor:cut", "key": "ctrl+x"},
          {"command_id": "editor:paste", "key": "ctrl+v"}
        ]
      },
      "zed": {
        "entries": [
          {"action": "editor::Copy", "key": "ctrl+c", "context": "Editor"},
          {"action": "editor::Cut", "key": "ctrl+x", "context": "Editor"},
          {"action": "editor::Paste", "key": "ctrl+v", "context": "Editor"}
        ]
      },
      "note": "Adds ctrl+c/x/v as working shortcuts on macOS alongside the native Cmd+C/X/V, not replacing them. VS Code's own ctrl+c/x/v for these commands are gated to non-Mac platforms by VS Code itself, so this only adds real capability on Mac (harmless no-op on Linux, which already has it natively). Zed's entries are editor-only, so ctrl+c in its terminal still sends SIGINT."
    }
  ]
}
