{
  "bindings": [
    {
      "id": "move-line-up-down",
      "action": "Move Line Up / Down",
      "cheatsheet": {"group": "Editing", "label": "Move / Swap Line Up / Down"},
      "vscode": {
        "entries": [
          {"command": "editor.action.moveLinesUpAction", "key": "ctrl+shift+up", "when": "editorTextFocus && !editorReadonly"},
          {"command": "editor.action.moveLinesDownAction", "key": "ctrl+shift+down", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-editor.action.moveLinesUpAction", "key": "alt+up", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-editor.action.moveLinesDownAction", "key": "alt+down", "when": "editorTextFocus && !editorReadonly"}
        ]
      }
    },
    {
      "id": "swap-line-up-down-obsidian",
      "action": "Swap Line Up / Down (Obsidian)",
      "cheatsheet": false,
      "obsidian": {
        "entries": [
          {"command_id": "editor:swap-line-up", "key": "ctrl+shift+up"},
          {"command_id": "editor:swap-line-down", "key": "ctrl+shift+down"}
        ]
      },
      "note": "Same physical key as the VS Code Move Line Up/Down above."
    },
    {
      "id": "clone-caret-above-below",
      "action": "Clone Caret Above / Below",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "editor.action.insertCursorAbove", "key": "shift+alt+up", "when": "editorTextFocus"},
          {"command": "editor.action.insertCursorBelow", "key": "shift+alt+down", "when": "editorTextFocus"},
          {"command": "-editor.action.insertCursorAbove", "key": "ctrl+shift+up", "when": "editorTextFocus"},
          {"command": "-editor.action.insertCursorBelow", "key": "ctrl+shift+down", "when": "editorTextFocus"}
        ]
      }
    },
    {
      "id": "delete-line",
      "action": "Delete Line",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "editor.action.deleteLines", "key": "ctrl+y", "when": "textInputFocus && !editorReadonly"},
          {"command": "-redo", "key": "ctrl+y", "when": "textInputFocus && !editorReadonly"}
        ]
      },
      "obsidian": {"entries": [{"command_id": "editor:delete-paragraph", "key": "ctrl+y"}]},
      "note": "Strongest cross-app alignment in the project — matches Obsidian's own pre-existing binding. ctrl+y in VS Code deliberately displaces Redo (Redo stays on ctrl+shift+z)."
    },
    {
      "id": "duplicate-line",
      "action": "Duplicate Line or Selection",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "editor.action.duplicateSelection", "key": "ctrl+d", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-editor.action.addSelectionToNextFindMatch", "key": "ctrl+d"}
        ]
      },
      "note": "VS Code has no default chord for Duplicate Selection (which duplicates the whole line when nothing is selected), so it takes ctrl+d here, displacing Add Selection to Next Find Match — that one stays available on ctrl+shift+l (Select All Occurrences, VS Code's native default). Obsidian has no duplicate-line command at all."
    },
    {
      "id": "join-lines",
      "action": "Join Lines",
      "cheatsheet": {"group": "Editing"},
      "vscode": {"entries": [{"command": "editor.action.joinLines", "key": "ctrl+shift+j"}]},
      "note": "Plain ctrl+j was rejected — it collides with VS Code's own Toggle Panel chord."
    },
    {
      "id": "insert-line-above",
      "action": "Insert Line Above",
      "cheatsheet": {"group": "Editing"},
      "vscode": {"entries": [{"command": "editor.action.insertLineBefore", "key": "ctrl+shift+enter", "when": "editorTextFocus && !editorReadonly"}]}
    },
    {
      "id": "toggle-word-wrap",
      "action": "Toggle Word Wrap",
      "cheatsheet": {"group": "Editing"},
      "vscode": {"entries": [{"command": "editor.action.toggleWordWrap", "key": "alt+z"}]}
    },
    {
      "id": "comment-line",
      "action": "Comment Line",
      "cheatsheet": {"group": "Editing", "keys": ["ctrl+/"], "note": "also Ctrl+7 · Ctrl+Numpad÷"},
      "vscode": {
        "entries": [
          {"command": "editor.action.commentLine", "key": "ctrl+7", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-workbench.action.focusSeventhEditorGroup", "key": "ctrl+7"},
          {"command": "editor.action.commentLine", "key": "ctrl+numpad_divide", "when": "editorTextFocus && !editorReadonly"}
        ]
      },
      "note": "Plain ctrl+/ needs no VS Code entry — already the native default. ctrl+7 and numpad-divide are accommodations for a Spanish keyboard layout."
    },
    {
      "id": "organize-imports",
      "action": "Organize Imports",
      "cheatsheet": {"group": "Editing"},
      "vscode": {
        "entries": [
          {"command": "editor.action.organizeImports", "key": "ctrl+alt+o", "when": "editorTextFocus && !editorReadonly"},
          {"command": "-editor.action.organizeImports", "key": "shift+alt+o", "when": "editorTextFocus && !editorReadonly"}
        ]
      }
    },
    {
      "id": "new-terminal",
      "action": "New Terminal",
      "cheatsheet": {"group": "App / window"},
      "vscode": {
        "entries": [
          {"command": "workbench.action.terminal.new", "key": "ctrl+t"},
          {"command": "-workbench.action.showAllSymbols", "key": "ctrl+t"}
        ]
      },
      "note": "Overlaps Nautilus's own ctrl+t = New Tab — accepted deliberately, matches the same convention browsers use."
    },
    {
      "id": "select-paragraph",
      "action": "Select Paragraph",
      "cheatsheet": {"group": "Editing"},
      "reserved_key": "ctrl+alt+u",
      "note": "Confirmed free in VS Code's own default keymap, but no native action exists to select a whole paragraph. Not implemented — nothing to bind yet. Keeping the key reserved here so nothing else claims ctrl+alt+u later."
    },
    {
      "id": "surround-with-backticks",
      "action": "Surround with `` (inline code)",
      "cheatsheet": {"group": "Markdown", "label": "Surround with `code` (inline)", "keys": ["ctrl+shift+k"]},
      "vscode": {"entries": [{"command": "markdown.extension.editing.toggleCodeSpan", "key": "ctrl+shift+k"}]},
      "note": "Requires the Markdown All in One VS Code extension (yzhang.markdown-all-in-one) — no built-in alternative exists. ctrl+shift+k displaces VS Code's own Delete Line default, which is harmless since Delete Line already lives on ctrl+y in this project. See toggle-inline-code-obsidian for the equivalent, pre-existing Obsidian binding (kept on its own separate key, not unified)."
    },
    {
      "id": "surround-with-code-block",
      "action": "Surround with code block (fenced)",
      "cheatsheet": {"group": "Markdown"},
      "vscode": {"entries": [{"command": "markdown.extension.editing.toggleCodeBlock", "key": "ctrl+alt+k"}]},
      "note": "Requires the same Markdown All in One VS Code extension as surround-with-backticks. See insert-codeblock-obsidian for the equivalent, pre-existing Obsidian binding (kept on its own separate key, not unified)."
    },
    {
      "id": "toggle-pin",
      "action": "Toggle Pin Editor Tab",
      "cheatsheet": {"group": "App / window"},
      "vscode": {
        "entries": [
          {"command": "workbench.action.pinEditor", "key": "shift+alt+p", "when": "!activeEditorIsPinned"},
          {"command": "workbench.action.unpinEditor", "key": "shift+alt+p", "when": "activeEditorIsPinned"}
        ]
      },
      "obsidian": {"entries": [{"command_id": "workspace:toggle-pin", "key": "shift+alt+p"}]},
      "note": "VS Code has no single 'toggle pin' command (a feature request for one is still open upstream) — two conditional bindings simulate it. shift+alt+p rather than ctrl+alt+p: Omarchy binds ctrl+alt+p system-wide (toggle preedit), so it never reaches the editor. shift+alt+p was freed when the PDF-export binding was dropped."
    },
    {
      "id": "reveal-active-file-obsidian",
      "action": "Reveal Active File in Explorer (Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Reveal Active File in Explorer"},
      "obsidian": {"entries": [{"command_id": "file-explorer:reveal-active-file", "key": "ctrl+shift+y"}]}
    },
    {
      "id": "open-with-default-app",
      "action": "Open / Show in Default App (Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Open / Show in Default App"},
      "obsidian": {
        "entries": [
          {"command_id": "open-with-default-app:open", "key": "ctrl+shift+o"},
          {"command_id": "open-with-default-app:show", "key": "ctrl+shift+s"}
        ]
      }
    },
    {
      "id": "search-replace-obsidian",
      "action": "Search & Replace (Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Search & Replace"},
      "obsidian": {"entries": [{"command_id": "editor:open-search-replace", "key": "ctrl+r"}]}
    },
    {
      "id": "edit-task-obsidian",
      "action": "Edit Task (Tasks plugin, Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Edit Task (Tasks plugin)"},
      "obsidian": {
        "entries": [
          {"command_id": "obsidian-tasks-plugin:edit-task", "key": "ctrl+shift+t"},
          {"command_id": "workspace:undo-close-pane"}
        ]
      },
      "note": "Harmless no-op in a vault without the Tasks plugin installed. Unbinds Obsidian's default Undo Close Tab (Mod+Shift+T), which is Ctrl+Shift+T on Linux and would otherwise collide."
    },
    {
      "id": "prev-next-tab-obsidian",
      "action": "Previous / Next Tab (Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Previous / Next Tab"},
      "obsidian": {
        "entries": [
          {"command_id": "workspace:previous-tab", "key": "ctrl+shift+tab"},
          {"command_id": "workspace:next-tab", "key": "ctrl+tab"}
        ]
      }
    },
    {
      "id": "insert-codeblock-obsidian",
      "action": "Insert Code Block (Obsidian)",
      "cheatsheet": false,
      "obsidian": {"entries": [{"command_id": "editor:insert-codeblock", "key": "ctrl+shift+\\"}]},
      "note": "Obsidian's own pre-existing binding for the concept behind surround-with-code-block — kept on its own key, not unified with VS Code's ctrl+alt+k."
    },
    {
      "id": "toggle-inline-code-obsidian",
      "action": "Toggle Inline Code (Obsidian)",
      "cheatsheet": false,
      "obsidian": {"entries": [{"command_id": "editor:toggle-code", "key": "ctrl+shift+="}]},
      "note": "Obsidian's own pre-existing binding for the concept behind surround-with-backticks — kept on its own key, not unified with the ctrl+shift+k used elsewhere."
    },
    {
      "id": "daily-notes-obsidian",
      "action": "Open Daily Note (Obsidian)",
      "cheatsheet": {"group": "Obsidian only", "label": "Open Daily Note"},
      "obsidian": {
        "entries": [
          {"command_id": "daily-notes", "key": "ctrl+n"},
          {"command_id": "file-explorer:new-file"}
        ]
      },
      "note": "Unbinds Obsidian's default New Note (Mod+N), which is Ctrl+N on Linux and would otherwise collide."
    },
    {
      "id": "zoom-in-out",
      "action": "Zoom In / Out (whole-app UI scale, not text size)",
      "cheatsheet": {"group": "App / window", "label": "Zoom In / Out (UI scale)", "keys": ["ctrl+plus", "ctrl+minus"]},
      "obsidian": {
        "entries": [
          {"command_id": "window:zoom-in", "key": "ctrl+plus"},
          {"command_id": "window:zoom-out", "key": "ctrl+minus"}
        ]
      },
      "note": "VS Code needs no entries — ctrl+plus/ctrl+minus are already its native zoom in/out on every platform. Nautilus already uses the same keys by its own convention. Reset is deliberately NOT unified — each app keeps its own working default (VS Code ctrl+numpad0, Obsidian ctrl+0) since forcing one key costs more than a rarely-used action is worth."
    },
    {
      "id": "copy-cut-paste",
      "action": "Copy / Cut / Paste",
      "cheatsheet": {"group": "App / window"},
      "vscode": {
        "entries": [
          {"command": "editor.action.clipboardCopyAction", "key": "ctrl+c"},
          {"command": "editor.action.clipboardCutAction", "key": "ctrl+x"},
          {"command": "editor.action.clipboardPasteAction", "key": "ctrl+v"}
        ]
      },
      "obsidian": {
        "entries": [
          {"command_id": "editor:copy", "key": "ctrl+c"},
          {"command_id": "editor:cut", "key": "ctrl+x"},
          {"command_id": "editor:paste", "key": "ctrl+v"}
        ]
      },
      "note": "Adds ctrl+c/x/v as working shortcuts on macOS alongside the native Cmd+C/X/V, not replacing them. VS Code's own ctrl+c/x/v for these commands are gated to non-Mac platforms by VS Code itself, so this only adds real capability on Mac (harmless no-op on Linux, which already has it natively)."
    }
  ]
}
